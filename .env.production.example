# Copy this file to .env on your server, then replace the placeholders.
# 以后就算是换服务器，重新部署，或者是被别人接手这个文件后，不会忘记需要配置啥东西
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@TEACHER_DB_HOST:5432/DB_NAME
REDIS_URL=redis://redis:6379

NODE_ENV=production
PORT=4001
CORS_ORIGINS=https://codestory.example.com
# Keep the legacy secret during migration. Use two different random secrets
# after the double-token login flow is enabled.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password

# AI tutor - Alibaba Cloud Bailian / Qwen
QWEN_API_KEY=your-qwen-api-key
# Optional overrides. Defaults: qwen-plus and mainland China DashScope endpoint.
AI_MODEL=qwen-plus
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=1000

# Alibaba Cloud OSS Configuration
# 在阿里云控制台创建 AccessKey 和 Bucket 后填写
OSS_REGION=oss-cn-beijing
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=your-bucket-name
# 如果配置了自定义域名，填写自定义域名（可选，不填则使用默认域名）
# 例: https://img.yourdomain.com
OSS_DOMAIN=

# Use the public address that your browser will visit.
# Examples:
# NEXT_PUBLIC_API_BASE_URL=http://123.123.123.123
# NEXT_PUBLIC_API_BASE_URL=https://codestory.example.com
NEXT_PUBLIC_API_BASE_URL=http://YOUR_SERVER_PUBLIC_IP
NEXT_PUBLIC_UPLOAD_PROXY_URL=http://YOUR_SERVER_PUBLIC_IP
