# Copy this file to .env on your server, then replace every placeholder.
# PostgreSQL runs in the production Compose stack and is not published to the host.
POSTGRES_USER=codestory_admin
POSTGRES_PASSWORD=replace-with-a-strong-admin-password
POSTGRES_DB=codestory
POSTGRES_APP_USER=codestory_app
POSTGRES_APP_PASSWORD=replace-with-a-different-strong-app-password
# URL-encode reserved characters in the password used below.
DATABASE_URL=postgresql://codestory_app:URL_ENCODED_APP_PASSWORD@postgres:5432/codestory
REDIS_URL=redis://redis:6379

NODE_ENV=production
PORT=4001
CORS_ORIGINS=https://codestory.example.com
# Keep the legacy secret during migration. Use two different random secrets
# after the double-token login flow is enabled.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password

# AI tutor - SiliconFlow. Keep RAG disabled until migration, reindexing, and
# production smoke checks pass; then enable it explicitly.
AI_API_KEY=your-siliconflow-api-key
AI_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=1000
# grounded-v3 uses the audited grounded-v3.1-boundary prompt revision.
AI_TUTOR_PROMPT_VERSION=grounded-v3
# Changing dimensions requires a database migration and full vector index rebuild.
AI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
AI_EMBEDDING_BATCH_SIZE=10
AI_EMBEDDING_DIMENSIONS=1024
# Optional; defaults to AI_BASE_URL.
AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AI_RAG_ENABLED=false
AI_GRAPH_ENABLED=false
AI_GRAPH_VERSION=guided-learning-v1
# Stage 6 operational thresholds. Reports emit one JSON object per run and exit 2
# when a threshold is breached, so cron/systemd can alert without an external platform.
AI_ALERT_MIN_SUCCESS_RATE=0.95
# Required comma-separated measured scene:milliseconds baselines. Use the exact scene
# names emitted by ai_call_logs. Unlisted scenes report INSUFFICIENT_DATA; replace these
# provisional examples with measured production-smoke baselines before enabling alerts.
AI_ALERT_SCENE_P95_BASELINES_MS=lesson-chat:3000,guided-learning:30000,exercise-generation:30000,code-grading:30000,choice-explanation:30000,exercise-hint:30000,rag-embedding:30000
# Provider price examples in USD per one million tokens. Verify the current provider
# price sheet and replace both values; missing prices make cost coverage incomplete.
AI_INPUT_COST_USD_PER_MILLION_TOKENS=0.50
AI_OUTPUT_COST_USD_PER_MILLION_TOKENS=2.00
AI_DAILY_BUDGET_USD=10
AI_BUDGET_WARNING_RATIO=0.8
AI_CHECKPOINT_RETENTION_DAYS=30
AI_CALL_LOG_RETENTION_DAYS=90
# Per-admin distributed limit for the high-cost AI exercise generation route.
AI_EXERCISE_GENERATION_RATE_LIMIT=5
AI_EXERCISE_GENERATION_RATE_WINDOW_MS=600000
AI_CHAT_RATE_LIMIT=20
AI_CHAT_RATE_WINDOW_MS=600000
AI_GUIDED_LEARNING_RATE_LIMIT=30
AI_GUIDED_LEARNING_RATE_WINDOW_MS=600000
AI_EXERCISE_ASSISTANCE_RATE_LIMIT=20
AI_EXERCISE_ASSISTANCE_RATE_WINDOW_MS=600000
AI_CODE_GRADING_RATE_LIMIT=20
AI_CODE_GRADING_RATE_WINDOW_MS=600000
# Separate budget for a batch of up to five structured candidates.
AI_EXERCISE_GENERATION_MAX_TOKENS=3500
# Exercise generation can take longer than ordinary chat requests under provider load.
AI_EXERCISE_GENERATION_TIMEOUT_MS=180000
# Optional dedicated HMAC secret for recommendation event tokens. When omitted,
# JWT_ACCESS_SECRET is used; never use a hard-coded application fallback.
RECOMMENDATION_TOKEN_SECRET=replace-with-a-dedicated-random-secret
LOG_LEVEL=info

# Deleted course content stays recoverable for 30 days. The scheduled purge
# permanently removes only expired content without learning/chat records.
CONTENT_RETENTION_DAYS=30
CONTENT_PURGE_ENABLED=true

# Alibaba Cloud OSS Configuration
# Bucket 可保持 private；图片通过后端 /uploads 路径代理，不直接暴露 OSS 地址。
OSS_REGION=oss-cn-beijing
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=your-bucket-name

# Use the exact public origin that the browser will visit, including a non-default
# port when applicable. Changing either value requires rebuilding the frontend image.
# Examples:
# NEXT_PUBLIC_API_BASE_URL=http://123.123.123.123
# NEXT_PUBLIC_API_BASE_URL=http://123.123.123.123:18080
# NEXT_PUBLIC_API_BASE_URL=https://codestory.example.com
NEXT_PUBLIC_API_BASE_URL=http://YOUR_SERVER_PUBLIC_IP
NEXT_PUBLIC_UPLOAD_PROXY_URL=http://YOUR_SERVER_PUBLIC_IP
