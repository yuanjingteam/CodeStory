generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model exercises {
  id                 Int                  @id @default(autoincrement())
  title_zh           String               @db.VarChar(255)
  description_zh     String
  track_type         String               @db.VarChar(50)
  initial_code       String?
  solution           String
  hint1              String?
  hint2              String?
  hint3              String?
  difficulty         Int?
  order_index        Int
  check_type         String               @default("result_match") @db.VarChar(50)
  expected_result    Json?                @db.Json
  test_data          Json?                @db.Json
  metadata           Json?                @db.Json
  enable_ai_grading  Boolean              @default(false)
  ai_prompt          String?
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @default(now()) @db.Timestamp(6)
  course_id          Int?
  lessons            lessons?             @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  submission_history submission_history[]
  user_progress      user_progress[]
}

model lessons {
  id             Int         @id(map: "courses_pkey") @default(autoincrement())
  track_id       Int
  title_zh       String      @db.VarChar(255)
  description_zh String?
  difficulty     Int
  order_index    Int
  is_active      Boolean     @default(true)
  created_at     DateTime    @default(now()) @db.Timestamp(6)
  updated_at     DateTime    @default(now()) @db.Timestamp(6)
  exercises      exercises[]
  tracks         tracks      @relation(fields: [track_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "courses_track_id_fkey")
}

model pgmigrations {
  id     Int      @id @default(autoincrement())
  name   String   @db.VarChar(255)
  run_on DateTime @db.Timestamp(6)
}

model submission_history {
  id                Int       @id @default(autoincrement())
  user_id           Int
  exercise_id       Int
  code              String
  is_correct        Boolean?
  ai_score          Int?
  ai_feedback       String?
  execution_time_ms Int?
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  exercises         exercises @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model tracks {
  id             Int       @id @default(autoincrement())
  slug           String    @unique @db.VarChar(100)
  title_zh       String    @db.VarChar(255)
  description_zh String?
  icon           String?   @db.VarChar(255)
  order_index    Int
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @default(now()) @db.Timestamp(6)
  lessons        lessons[]
}

model user_progress {
  id               Int       @id @default(autoincrement())
  user_id          Int
  exercise_id      Int
  completed        Boolean   @default(false)
  attempts         Int       @default(0)
  last_code        String?
  hints_used       Int       @default(0)
  last_ai_score    Int?
  last_ai_feedback String?
  completed_at     DateTime? @db.Timestamp(6)
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime  @default(now()) @db.Timestamp(6)
  exercises        exercises @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, exercise_id])
}

model users {
  id                 Int                  @id @default(autoincrement())
  email              String               @unique @db.VarChar(255)
  password_hash      String               @db.VarChar(255)
  name               String?              @db.VarChar(100)
  avatar_url         String?              @db.VarChar(500)
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @default(now()) @db.Timestamp(6)
  submission_history submission_history[]
  user_progress      user_progress[]
}
