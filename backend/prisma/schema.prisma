generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id               String             @id @default(uuid()) @db.Char(36)
  email            String             @unique @db.VarChar(255)
  role             Int                @default(0) @db.SmallInt
  password         String             @db.VarChar(255)
  nickname         String?            @db.VarChar(50)
  avatar           String?            @db.VarChar(500)
  sex              Int?               @db.SmallInt
  occupation       String?            @db.VarChar(100)
  score            Int                @default(0)
  level            Int                @default(0) @db.SmallInt
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  updated_at       DateTime           @updatedAt @db.Timestamp(6)
  is_delete        Int                @default(0) @db.SmallInt
  ai_chat_sessions ai_chat_sessions[]
  answers          answer[]
  courses_progress courses_progress[]
  lessons_progress lessons_progress[]
  wechat_users     wechat_users[]

  @@index([is_delete])
  @@index([created_at])
}

model courses {
  id               String             @id @default(uuid()) @db.Char(36)
  cover_url        String?            @db.VarChar(500)
  title            String             @db.VarChar(100)
  description      String?
  level            Int                @default(0) @db.SmallInt
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  updated_at       DateTime           @updatedAt @db.Timestamp(6)
  is_delete        Int                @default(0) @db.SmallInt
  course_seq       Int                @default(autoincrement())
  chapters         chapters[]
  courses_progress courses_progress[]

  @@index([level])
  @@index([is_delete])
  @@index([created_at])
}

model courses_progress {
  id                String    @id @default(uuid()) @db.Char(36)
  user_id           String    @db.Char(36)
  course_id         String    @db.Char(36)
  completed_lessons Int       @default(0)
  total_lessons     Int       @default(0)
  status            Int       @default(0) @db.SmallInt
  last_learned_at   DateTime? @db.Timestamp(6)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @updatedAt @db.Timestamp(6)
  is_delete         Int       @default(0) @db.SmallInt
  courses           courses   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, course_id])
  @@index([user_id])
  @@index([course_id])
  @@index([status])
  @@index([is_delete])
}

model chapters {
  id          String    @id @default(uuid()) @db.Char(36)
  course_id   String    @db.Char(36)
  title       String    @db.VarChar(255)
  order       Int       @default(0)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @updatedAt @db.Timestamp(6)
  is_delete   Int       @default(0) @db.SmallInt
  chapter_seq Int       @default(autoincrement())
  courses     courses   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  lessons     lessons[]

  @@unique([course_id, order])
  @@index([course_id])
  @@index([is_delete])
}

model lessons {
  id               String             @id @default(uuid()) @db.Char(36)
  chapter_id       String             @db.Char(36)
  title            String             @db.VarChar(255)
  content          String?
  difficulty       Int                @default(0) @db.SmallInt
  score_avg        Int                @default(0)
  estimated_time   Int                @default(0)
  order            Int                @default(0)
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  updated_at       DateTime           @updatedAt @db.Timestamp(6)
  is_delete        Int                @default(0) @db.SmallInt
  lesson_seq       Int                @default(autoincrement())
  ai_chat_sessions ai_chat_sessions[]
  exercises        exercises[]
  chapters         chapters           @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  lessons_progress lessons_progress[]

  @@unique([chapter_id, order])
  @@index([chapter_id])
  @@index([difficulty])
  @@index([is_delete])
}

model lessons_progress {
  id              String    @id @default(uuid()) @db.Char(36)
  user_id         String    @db.Char(36)
  lesson_id       String    @db.Char(36)
  status          Int       @default(0) @db.SmallInt
  mastery_level   Int       @default(0)
  last_learned_at DateTime? @db.Timestamp(6)
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @updatedAt @db.Timestamp(6)
  is_delete       Int       @default(0) @db.SmallInt
  lessons         lessons   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  users           users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lesson_id])
  @@index([user_id])
  @@index([lesson_id])
  @@index([status])
  @@index([is_delete])
}

model exercises {
  id         String   @id @default(uuid()) @db.Char(36)
  lesson_id  String   @db.Char(36)
  type       String   @db.VarChar(20)
  knowledge  String?
  content    String
  answer     String
  analysis   String?
  difficulty Int      @default(1) @db.SmallInt
  source     String?  @db.VarChar(20)
  metadata   Json?    @db.Json
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
  is_delete  Int      @default(0) @db.SmallInt
  hints      Json?    @db.Json
  order      Int      @default(0)
  answers    answer[]
  lessons    lessons  @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@index([lesson_id])
  @@index([type])
  @@index([difficulty])
  @@index([source])
  @@index([is_delete])
}

model answer {
  id               String    @id @default(uuid()) @db.Char(36)
  user_id          String    @db.Char(36)
  exercise_id      String    @db.Char(36)
  answer           String?
  submission_count Int       @default(0)
  feedback         String?
  hint_level_used  Int       @default(0)
  score            Int       @default(0)
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime  @updatedAt @db.Timestamp(6)
  is_delete        Int       @default(0) @db.SmallInt
  exercises        exercises @relation(fields: [exercise_id], references: [id], onDelete: Cascade)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, exercise_id])
  @@index([user_id])
  @@index([exercise_id])
  @@index([is_delete])
}

model ai_chat_sessions {
  id                  String   @id @default(uuid()) @db.Char(36)
  user_id             String   @db.Char(36)
  lesson_id           String   @db.Char(36)
  state               Int      @default(0) @db.SmallInt
  current_exercise_id String?  @db.Char(36)
  hint_level          Int      @default(0)
  context             Json?    @db.Json
  created_at          DateTime @default(now()) @db.Timestamp(6)
  updated_at          DateTime @updatedAt @db.Timestamp(6)
  is_delete           Int      @default(0) @db.SmallInt
  lessons             lessons  @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  users               users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lesson_id])
  @@index([user_id])
  @@index([lesson_id])
  @@index([state])
  @@index([is_delete])
}

model wechat_users {
  id         String   @id @default(uuid()) @db.Char(36)
  user_id    String?  @db.Char(36)
  openid     String   @unique @db.VarChar(100)
  unionid    String?  @db.VarChar(100)
  nickname   String?  @db.VarChar(100)
  avatar     String?  @db.VarChar(500)
  gender     Int      @default(0) @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
  is_delete  Int      @default(0) @db.SmallInt
  user       users?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([unionid])
  @@index([is_delete])
}
