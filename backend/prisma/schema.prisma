generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id               String             @id @default(uuid()) @db.Char(36)
  email            String             @unique @db.VarChar(255)
  role             Int                @default(0) @db.SmallInt
  password         String             @db.VarChar(255)
  nickname         String?            @db.VarChar(50)
  avatar           String?            @db.VarChar(500)
  sex              Int?               @db.SmallInt
  occupation       String?            @db.VarChar(100)
  score            Int                @default(0)
  level            Int                @default(0) @db.SmallInt
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  updated_at       DateTime           @updatedAt @db.Timestamp(6)
  is_delete        Int                @default(0) @db.SmallInt
  ai_chat_sessions ai_chat_sessions[]
  code_submissions code_submissions[]
  answers          answer[]
  courses_progress courses_progress[]
  lessons_progress lessons_progress[]
  wechat_users     wechat_users[]

  @@index([is_delete])
  @@index([created_at])
}

model courses {
  id               String             @id @default(uuid()) @db.Char(36)
  cover_url        String?            @db.VarChar(500)
  title            String             @db.VarChar(100)
  description      String?
  level            Int                @default(0) @db.SmallInt
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  updated_at       DateTime           @updatedAt @db.Timestamp(6)
  deleted_at       DateTime?          @db.Timestamp(6)
  is_delete        Int                @default(0) @db.SmallInt
  course_seq       Int                @default(autoincrement())
  chapters         chapters[]
  courses_progress courses_progress[]

  @@index([level])
  @@index([is_delete])
  @@index([is_delete, deleted_at])
  @@index([created_at])
}

model courses_progress {
  id                String    @id @default(uuid()) @db.Char(36)
  user_id           String    @db.Char(36)
  course_id         String    @db.Char(36)
  completed_lessons Int       @default(0)
  total_lessons     Int       @default(0)
  status            Int       @default(0) @db.SmallInt
  last_learned_at   DateTime? @db.Timestamp(6)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @updatedAt @db.Timestamp(6)
  is_delete         Int       @default(0) @db.SmallInt
  courses           courses   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, course_id])
  @@index([user_id])
  @@index([course_id])
  @@index([status])
  @@index([is_delete])
}

model chapters {
  id          String    @id @default(uuid()) @db.Char(36)
  course_id   String    @db.Char(36)
  title       String    @db.VarChar(255)
  order       Int       @default(0)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @updatedAt @db.Timestamp(6)
  deleted_at  DateTime? @db.Timestamp(6)
  is_delete   Int       @default(0) @db.SmallInt
  chapter_seq Int       @default(autoincrement())
  courses     courses   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  lessons     lessons[]

  @@unique([course_id, order])
  @@index([course_id])
  @@index([is_delete])
  @@index([is_delete, deleted_at])
}

model lessons {
  id               String             @id @default(uuid()) @db.Char(36)
  chapter_id       String             @db.Char(36)
  title            String             @db.VarChar(255)
  content          String?
  difficulty       Int                @default(0) @db.SmallInt
  score_avg        Int                @default(0)
  estimated_time   Int                @default(0)
  order            Int                @default(0)
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  updated_at       DateTime           @updatedAt @db.Timestamp(6)
  deleted_at       DateTime?          @db.Timestamp(6)
  is_delete        Int                @default(0) @db.SmallInt
  knowledge_index_policy String       @default("auto") @db.VarChar(20)
  lesson_seq       Int                @default(autoincrement())
  ai_chat_sessions ai_chat_sessions[]
  exercises        exercises[]
  chapters         chapters           @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  lessons_progress lessons_progress[]

  @@unique([chapter_id, order])
  @@index([chapter_id])
  @@index([difficulty])
  @@index([is_delete])
  @@index([is_delete, deleted_at])
  @@index([knowledge_index_policy])
}

model lessons_progress {
  id              String    @id @default(uuid()) @db.Char(36)
  user_id         String    @db.Char(36)
  lesson_id       String    @db.Char(36)
  status          Int       @default(0) @db.SmallInt
  mastery_level   Int       @default(0)
  last_learned_at DateTime? @db.Timestamp(6)
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @updatedAt @db.Timestamp(6)
  is_delete       Int       @default(0) @db.SmallInt
  lessons         lessons   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  users           users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lesson_id])
  @@index([user_id])
  @@index([lesson_id])
  @@index([status])
  @@index([is_delete])
}

model exercises {
  id               String             @id @default(uuid()) @db.Char(36)
  lesson_id        String             @db.Char(36)
  type             String             @db.VarChar(20)
  knowledge        String?
  content          String
  answer           String
  analysis         String?
  difficulty       Int                @default(1) @db.SmallInt
  source           String?            @db.VarChar(20)
  review_status    String             @default("approved") @db.VarChar(20)
  gen_metadata     Json?              @db.Json
  generation_fingerprint String?      @db.Char(64)
  metadata         Json?              @db.Json
  hints            Json?              @db.Json
  order            Int                @default(0)
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  updated_at       DateTime           @updatedAt @db.Timestamp(6)
  deleted_at       DateTime?          @db.Timestamp(6)
  is_delete        Int                @default(0) @db.SmallInt
  knowledge_index_policy String       @default("auto") @db.VarChar(20)
  answers          answer[]
  code_submissions code_submissions[]
  lessons          lessons            @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@index([lesson_id])
  @@index([type])
  @@index([difficulty])
  @@index([source])
  @@index([review_status])
  @@index([review_status, created_at])
  @@index([is_delete])
  @@index([is_delete, deleted_at])
  @@index([knowledge_index_policy])
}

model answer {
  id               String    @id @default(uuid()) @db.Char(36)
  user_id          String    @db.Char(36)
  exercise_id      String    @db.Char(36)
  answer           String?
  submission_count Int       @default(0)
  feedback         String?
  hint_level_used  Int       @default(0)
  score            Int       @default(0)
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime  @updatedAt @db.Timestamp(6)
  is_delete        Int       @default(0) @db.SmallInt
  exercises        exercises @relation(fields: [exercise_id], references: [id], onDelete: Cascade)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, exercise_id])
  @@index([user_id])
  @@index([exercise_id])
  @@index([is_delete])
}

model ai_chat_sessions {
  id                  String             @id @default(uuid()) @db.Char(36)
  user_id             String             @db.Char(36)
  lesson_id           String             @db.Char(36)
  current_run_id      String?            @db.Char(36)
  state_version       Int                @default(0)
  graph_version       String?            @db.VarChar(30)
  state               Int                @default(0) @db.SmallInt
  current_exercise_id String?            @db.Char(36)
  hint_level          Int                @default(0)
  context             Json?              @db.Json
  created_at          DateTime           @default(now()) @db.Timestamp(6)
  updated_at          DateTime           @updatedAt @db.Timestamp(6)
  is_delete           Int                @default(0) @db.SmallInt
  messages            ai_chat_messages[]
  lessons             lessons            @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  users               users              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lesson_id])
  @@index([user_id])
  @@index([lesson_id])
  @@index([state])
  @@index([is_delete])
}

model knowledge_chunks {
  id             String   @id @default(uuid()) @db.Char(36)
  source_type    String   @db.VarChar(20)
  source_id      String   @db.Char(36)
  course_id      String?  @db.Char(36)
  lesson_id      String?  @db.Char(36)
  source_version DateTime @db.Timestamp(6)
  chunk_index    Int
  content        String
  content_hash   String   @db.Char(64)
  embedding      Unsupported("vector(1024)")
  metadata       Json?    @db.Json
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @updatedAt @db.Timestamp(6)
  is_delete      Int      @default(0) @db.SmallInt

  @@unique([source_type, source_id, chunk_index])
  @@index([course_id, lesson_id, source_type, source_id])
  @@index([source_type, source_id])
  @@index([is_delete])
}

model knowledge_index_state {
  id                String    @id @default(uuid()) @db.Char(36)
  source_type       String    @db.VarChar(20)
  source_id         String    @db.Char(36)
  source_updated_at DateTime  @db.Timestamp(6)
  index_generation  BigInt    @default(0)
  indexed_at        DateTime? @db.Timestamp(6)
  status            String    @default("pending") @db.VarChar(20)
  error_code        String?   @db.VarChar(100)
  embedding_model   String?   @db.VarChar(150)
  embedding_dimensions Int?
  index_version     String?   @db.VarChar(30)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @updatedAt @db.Timestamp(6)

  @@unique([source_type, source_id])
  @@index([status, indexed_at])
}

model learning_run_effects {
  id          String    @id @default(uuid()) @db.Char(36)
  run_id      String    @db.Char(36)
  node_name   String    @db.VarChar(80)
  effect_type String    @db.VarChar(80)
  effect_key  String    @unique @db.VarChar(255)
  payload     Json?     @db.Json
  status      String    @default("pending") @db.VarChar(20)
  error_code  String?   @db.VarChar(100)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  applied_at  DateTime? @db.Timestamp(6)

  @@index([run_id])
  @@index([status, created_at])
}

model ai_chat_messages {
  id           String           @id @default(uuid()) @db.Char(36)
  session_id   String           @db.Char(36)
  role         String           @db.VarChar(20)
  message_type String           @default("chat") @db.VarChar(30)
  content      String
  metadata     Json?            @db.Json
  created_at   DateTime         @default(now()) @db.Timestamp(6)
  deleted_at   DateTime?        @db.Timestamp(6)
  is_delete    Int              @default(0) @db.SmallInt
  session      ai_chat_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@index([created_at])
  @@index([is_delete])
  @@index([is_delete, deleted_at])
}

model code_submissions {
  id                String    @id @default(uuid()) @db.Char(36)
  user_id           String    @db.Char(36)
  exercise_id       String    @db.Char(36)
  code              String
  language          String    @db.VarChar(30)
  status            String    @default("queued") @db.VarChar(30)
  submission_no     Int
  compile_success   Boolean?
  passed_count      Int       @default(0)
  total_count       Int       @default(0)
  error_type        String?   @db.VarChar(30)
  execution_time_ms Int?
  memory_used_kb    Int?
  test_result       Json?     @db.Json
  functional_score  Int       @default(0)
  quality_score     Int       @default(0)
  hint_deduction    Int       @default(0)
  final_score       Int       @default(0)
  ai_review_status  String?   @db.VarChar(30)
  ai_review         Json?     @db.Json
  model             String?   @db.VarChar(100)
  rubric_version    String?   @db.VarChar(30)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @updatedAt @db.Timestamp(6)
  is_delete         Int       @default(0) @db.SmallInt
  user              users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  exercise          exercises @relation(fields: [exercise_id], references: [id], onDelete: Cascade)

  @@unique([user_id, exercise_id, submission_no])
  @@index([user_id])
  @@index([exercise_id])
  @@index([status])
  @@index([created_at])
  @@index([is_delete])
}

model wechat_users {
  id         String   @id @default(uuid()) @db.Char(36)
  user_id    String?  @db.Char(36)
  openid     String   @unique @db.VarChar(100)
  unionid    String?  @db.VarChar(100)
  nickname   String?  @db.VarChar(100)
  avatar     String?  @db.VarChar(500)
  gender     Int      @default(0) @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
  is_delete  Int      @default(0) @db.SmallInt
  user       users?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([unionid])
  @@index([is_delete])
}
